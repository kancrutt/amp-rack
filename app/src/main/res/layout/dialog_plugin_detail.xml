<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#15171B"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Red LED Status Dot -->
        <View
            android:id="@+id/detail_led"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/led_glowing_active" />

        <!-- Title & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/detail_plugin_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:text="Metal Guitar (MIX READY) - Black Album"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detail_plugin_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="AMP · NEURAL AMP (NAM)"
                android:textColor="#8F94A0"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pill Badge A1 -->
        <TextView
            android:id="@+id/detail_badge_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/gg_pill_bg"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="A1"
            android:textColor="#00FF66"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- ENABLED Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_enabled_btn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="ENABLED"
            android:textColor="#00E676"
            android:textSize="10sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:strokeColor="#00E676" />

        <!-- Close Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_close_btn"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:backgroundTint="#24262B"
            android:padding="0dp"
            android:text="✕"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <!-- Top Horizontal Accent Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="14dp"
        android:background="#00E676" />

    <!-- Two-Column Main Content Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Left Column: Amp/Gear Stack Render Graphic -->
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="260dp"
            android:background="#0C0D0F"
            android:padding="8dp">

            <ImageView
                android:id="@+id/detail_gear_render"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/gg_gear_placeholder" />
        </FrameLayout>

        <!-- Right Column: Model Browser + Tabs + Control Panels -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- MODEL Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODEL"
                android:textColor="#8F94A0"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="4dp"
                android:background="#24262B"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/detail_model_browse_btn"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:backgroundTint="#363942"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="Browse"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    app:cornerRadius="6dp" />

                <TextView
                    android:id="@+id/detail_model_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Metal Guitar (MIX READY) - Black Album"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- MAIN / ADVANCED Tabs -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#24262B"
                android:padding="2dp">

                <TextView
                    android:id="@+id/tab_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#363942"
                    android:paddingStart="14dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="4dp"
                    android:text="MAIN"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tab_advanced"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="14dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="4dp"
                    android:text="ADVANCED"
                    android:textColor="#8F94A0"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Grouped Panels Row: LEVEL & TONE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <!-- LEVEL Panel -->
                <LinearLayout
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="#1E2024"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="LEVEL"
                        android:textColor="#8F94A0"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:scrollbars="horizontal">

                        <LinearLayout
                            android:id="@+id/container_level_knobs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- TONE Panel -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#1E2024"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="TONE"
                        android:textColor="#8F94A0"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:scrollbars="horizontal">

                        <LinearLayout
                            android:id="@+id/container_tone_knobs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
