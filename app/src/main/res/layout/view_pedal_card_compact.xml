<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pedal_card_root"
    android:layout_width="220dp"
    android:layout_height="130dp"
    android:layout_gravity="center_vertical"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:background="@drawable/rounded_corners_pedal_3d"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Category color accent bar (left edge) -->
    <View
        android:id="@+id/category_accent_bar"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_gravity="center_vertical"
        android:background="@color/cat_amp_sel" />

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

    <!-- Top Row: Icon + Title + Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/pedal_icon"
            android:layout_width="24dp"
            android:layout_height="24dp" />

        <TextView
            android:id="@+id/pedal_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/plus_jakarta_sans"
            android:maxLines="1"
            android:text="TS9 TUBE SCREAMER"
            android:textColor="@color/gg_glass_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/plugin_delete"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="0dp"
            app:icon="@drawable/ic_baseline_delete_forever_24"
            app:iconPadding="0dp"
            app:iconSize="16dp"
            app:iconTint="@color/gg_glass_text_secondary" />
    </LinearLayout>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/pedal_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Neural FX (NAM)"
        android:textColor="@color/gg_glass_text_secondary"
        android:textSize="11sp" />

    <!-- Bottom Row: Pill Badge + LED Dot -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <!-- Badge Pill -->
        <TextView
            android:id="@+id/pedal_category_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@drawable/gg_pill_bg"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="A1"
            android:textColor="@color/gg_glass_text_primary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Green LED Dot -->
        <View
            android:id="@+id/pedal_led"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:background="@drawable/led_glowing_active" />
    </RelativeLayout>
</LinearLayout>

</LinearLayout>
