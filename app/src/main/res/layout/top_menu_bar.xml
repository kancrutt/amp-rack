<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/top_menu_bar_root"
    android:layout_width="match_parent"
    android:layout_height="@dimen/rack_top_bar_height"
    android:background="@drawable/glass_topbar_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:elevation="4dp">

    <!-- Home label -->
    <TextView
        android:id="@+id/top_menu_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="Home"
        android:textColor="@color/gg_glass_text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="@font/plus_jakarta_sans" />

    <!-- Navigation icons -->
    <ImageButton
        android:id="@+id/nav_first"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@android:color/transparent"
        android:contentDescription="First"
        android:src="@drawable/ic_baseline_arrow_back_ios_new_24"
        android:tint="@color/gg_glass_text_primary" />

    <ImageButton
        android:id="@+id/nav_prev"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="2dp"
        android:background="@android:color/transparent"
        android:contentDescription="Prev"
        android:src="@drawable/ic_baseline_arrow_back_ios_new_24"
        android:tint="@color/gg_glass_text_primary" />

    <ImageButton
        android:id="@+id/nav_play"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="2dp"
        android:background="@android:color/transparent"
        android:contentDescription="Play"
        android:src="@drawable/ic_baseline_play_arrow_24"
        android:tint="@color/gg_glass_text_primary" />

    <ImageButton
        android:id="@+id/nav_next"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="2dp"
        android:background="@android:color/transparent"
        android:contentDescription="Next"
        android:src="@drawable/ic_baseline_arrow_forward_ios_24"
        android:tint="@color/gg_glass_text_primary" />

    <ImageButton
        android:id="@+id/nav_last"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="2dp"
        android:background="@android:color/transparent"
        android:contentDescription="Last"
        android:src="@drawable/ic_baseline_arrow_forward_ios_24"
        android:tint="@color/gg_glass_text_primary" />

    <!-- Preset dropdown -->
    <Spinner
        android:id="@+id/top_menu_preset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:background="@drawable/glass_panel_bg"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

    <!-- Scene button group -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/top_menu_scene"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Scene"
        android:textColor="@color/gg_accent"
        android:textSize="11sp"
        android:textStyle="bold"
        app:cornerRadius="4dp"
        app:strokeColor="@color/gg_accent"
        app:strokeWidth="1dp" />

    <!-- Tap Tempo -->
    <TextView
        android:id="@+id/top_menu_tap_tempo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:background="@drawable/glass_panel_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Tap Tempo"
        android:textColor="@color/gg_accent"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Spacer -->
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <!-- Info display -->
    <LinearLayout
        android:id="@+id/top_menu_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/info_device_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Device"
            android:textColor="@color/gg_glass_text_secondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/info_value_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00"
            android:textColor="@color/gg_glass_text_primary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
