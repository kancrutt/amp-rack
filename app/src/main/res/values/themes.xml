<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme — Full Material 3 (Material You / Dynamic Dark) -->
    <style name="Theme.AmpRack" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Global Google Plus Jakarta Sans typography -->
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <!-- Primary brand color (Material 3 Gold / Orange Accent) -->
        <item name="colorPrimary">#FFAA00</item>
        <item name="colorOnPrimary">#121214</item>
        <item name="colorPrimaryContainer">#2A2215</item>
        <item name="colorOnPrimaryContainer">#FFAA00</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#8F94A0</item>
        <item name="colorOnSecondary">#121214</item>
        <item name="colorSecondaryContainer">#1E2024</item>
        <item name="colorOnSecondaryContainer">#ECEFF1</item>
        <!-- Background & Surface Colors (Dark Pro Audio Tone) -->
        <item name="android:colorBackground">#121214</item>
        <item name="colorSurface">#1A1C20</item>
        <item name="colorOnSurface">#ECEFF1</item>
        <item name="colorSurfaceVariant">#24262B</item>
        <item name="colorOnSurfaceVariant">#8F94A0</item>
        <item name="colorOutline">#3A3D45</item>
        <item name="colorOutlineVariant">#2E3138</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">#121214</item>
        <item name="android:navigationBarColor" tools:targetApi="l">#0B0B0C</item>
        <!-- Category icon tints (UI/UX spec 4.2 two-axis color system) -->
        <item name="color_cat_amp_active">@color/color_cat_amp_active</item>
        <item name="color_cat_cab_active">@color/color_cat_cab_active</item>
        <item name="color_cat_distortion_active">@color/color_cat_distortion_active</item>
        <item name="color_cat_modulation_active">@color/color_cat_modulation_active</item>
        <item name="color_cat_delay_active">@color/color_cat_delay_active</item>
        <item name="color_cat_reverb_active">@color/color_cat_reverb_active</item>
        <item name="color_cat_dynamics_active">@color/color_cat_dynamics_active</item>
        <item name="color_cat_eq_active">@color/color_cat_eq_active</item>
        <item name="color_cat_pitch_active">@color/color_cat_pitch_active</item>
        <item name="color_cat_wah_active">@color/color_cat_wah_active</item>
        <item name="color_cat_volume_active">@color/color_cat_volume_active</item>
        <item name="color_cat_noisegate_active">@color/color_cat_noisegate_active</item>
        <item name="color_cat_amp_inactive">@color/color_cat_amp_inactive</item>
        <item name="color_cat_cab_inactive">@color/color_cat_cab_inactive</item>
        <item name="color_cat_distortion_inactive">@color/color_cat_distortion_inactive</item>
        <item name="color_cat_modulation_inactive">@color/color_cat_modulation_inactive</item>
        <item name="color_cat_delay_inactive">@color/color_cat_delay_inactive</item>
        <item name="color_cat_reverb_inactive">@color/color_cat_reverb_inactive</item>
        <item name="color_cat_dynamics_inactive">@color/color_cat_dynamics_inactive</item>
        <item name="color_cat_eq_inactive">@color/color_cat_eq_inactive</item>
        <item name="color_cat_pitch_inactive">@color/color_cat_pitch_inactive</item>
        <item name="color_cat_wah_inactive">@color/color_cat_wah_inactive</item>
        <item name="color_cat_volume_inactive">@color/color_cat_volume_inactive</item>
        <item name="color_cat_noisegate_inactive">@color/color_cat_noisegate_inactive</item>
    </style>

