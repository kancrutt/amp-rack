<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_overlay_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="TONE3000"
            android:textColor="#FF8A00"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/t3k_detail_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="#1A1A1E"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="TONE3000"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <android.widget.ImageButton
            android:id="@+id/t3k_detail_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_baseline_close_24"
            app:tint="@color/gg_glass_text_secondary" />
    </RelativeLayout>

    <ProgressBar
        android:id="@+id/t3k_detail_loading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:indeterminateTint="#FF8A00" />

    <TextView
        android:id="@+id/t3k_detail_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textColor="#FF5252"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textSize="12sp"
        android:gravity="center"
        android:padding="12dp"
        android:background="@drawable/glass_card_bg" />

    <LinearLayout
        android:id="@+id/t3k_detail_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/t3k_detail_image"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:scaleType="centerCrop"
                android:background="@drawable/glass_card_bg"
                android:src="@drawable/gg_gear_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/t3k_detail_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textColor="@color/gg_glass_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/t3k_detail_creator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textColor="@color/gg_glass_text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/t3k_detail_gear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/glass_card_bg"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:textColor="@color/gg_glass_text_primary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/t3k_detail_format"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/glass_card_bg"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:textColor="#FF8A00"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/t3k_detail_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textColor="@color/gg_glass_text_secondary"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp"
            android:maxLines="4"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="MODELS"
            android:textColor="@color/gg_glass_text_primary"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/glass_panel_bg"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/t3k_models_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/t3k_detail_browse_btn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:text="Browse TONE3000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="@font/plus_jakarta_sans"
            app:cornerRadius="8dp"
            android:backgroundTint="@color/gg_surface_2"
            android:textColor="#FF8A00" />

    </LinearLayout>

</LinearLayout>
