<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/m3_glass_surface_dark"
                android:endColor="@color/m3_glass_surface_base"
                android:type="linear" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/m3_glass_stroke_subtle" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/m3_glass_gradient_start"
                android:endColor="@color/m3_glass_gradient_end"
                android:type="linear" />
            <corners android:radius="11dp" />
            <stroke
                android:width="1dp"
                android:color="@color/m3_glass_stroke_border" />
        </shape>
    </item>
</layer-list>
