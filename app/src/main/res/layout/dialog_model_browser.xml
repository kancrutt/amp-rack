<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_overlay_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Modal Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="SELECT MODEL"
            android:textColor="@color/gg_glass_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/dialog_model_close_x"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_baseline_close_24"
            app:tint="@color/gg_glass_text_secondary" />
    </RelativeLayout>

    <!-- Search Box for Models/Plugins -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/glass_card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_baseline_search_24"
            app:tint="@color/gg_glass_text_secondary" />

        <EditText
            android:id="@+id/model_search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/plus_jakarta_sans"
            android:hint="Search models &amp; effects…"
            android:textColor="@color/gg_glass_text_primary"
            android:textColorHint="@color/gg_glass_text_secondary"
            android:textSize="12sp"
            android:imeOptions="actionDone"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/model_search_clear"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_baseline_close_24"
            android:visibility="gone"
            app:tint="@color/gg_glass_text_secondary" />
    </LinearLayout>

    <!-- Two-Column Body: Left Categories, Right Model Items -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:orientation="horizontal">

        <!-- Left Category Column (Scrollable) -->
        <ScrollView
            android:layout_width="140dp"
            android:layout_height="match_parent"
            android:background="@drawable/glass_panel_bg"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/category_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Right Model List Column (Scrollable) -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/glass_panel_bg"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/models_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- Bottom Close Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialog_model_close_btn"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/gg_surface_2"
        android:text="CLOSE"
        android:textColor="@color/gg_glass_text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="@font/plus_jakarta_sans"
        app:cornerRadius="8dp" />
</LinearLayout>
