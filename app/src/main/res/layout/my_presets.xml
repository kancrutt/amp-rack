<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/my_presets_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gg_bg">

    <TextView
        android:id="@+id/presets_panel_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text=""
        android:fontFamily="@font/plus_jakarta_sans"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/gg_glass_text_secondary"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_margin="10dp"
        android:id="@+id/collections_header">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Collection"
            android:textColor="@color/gg_text"/>

        <Spinner
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:id="@+id/collections_spinner"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/search_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:orientation="horizontal">

        <EditText
            android:layout_width="wrap_content"
            android:id="@+id/search_presets"
            android:hint="Search"
            android:background="@drawable/gg_card_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="@color/gg_text"
            android:textColorHint="@color/gg_hint"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <ToggleButton
            android:layout_marginLeft="10dp"
            android:layout_width="50dp"
            android:id="@+id/toggle_show_favorites"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:textOff=""
            android:textOn=""/>

        <Button
            android:id="@+id/sort_button"
            android:layout_width="50dp"
            android:background="@color/fui_transparent"
            android:layout_height="wrap_content"
            android:drawableRight="@drawable/ic_baseline_filter_list_24"
            android:backgroundTint="@color/fui_transparent"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:id="@+id/my_presets_recycler"
        android:layout_height="0dp"
        android:padding="6dp"
        android:clipToPadding="false"
        android:layout_weight="1"/>

    <!-- Empty state: shown when the preset list has zero items -->
    <TextView
        android:id="@+id/presets_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        android:text="No presets yet.\nTap the save icon on the Board (top bar) to create one."
        android:textColor="@color/gg_glass_text_secondary"
        android:textSize="13sp"/>

    <LinearLayout
        android:visibility="gone"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:gravity="left"
        android:layout_height="wrap_content">
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="More"
            android:id="@+id/load_more"
            android:drawableLeft="@drawable/baseline_file_download_24"
            android:visibility="invisible"
            android:background="@color/fui_transparent"/>
        <Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/load_progress"
            android:visibility="invisible"
            android:indeterminateTint="@color/gg_accent"
            android:layout_gravity="end"/>
    </LinearLayout>
</LinearLayout>
