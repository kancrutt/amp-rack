<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <Preference
        app:fragment="com.kancrutt.gigginggear.SettingsActivity$MessagesFragment"
        app:icon="@drawable/ic_baseline_volume_up_24"
        app:key="messages_header"
        app:title="Audio Devices &amp; Buffer" />

    <Preference
        app:fragment="com.kancrutt.gigginggear.SettingsActivity$ThemeFragment"
        app:icon="@drawable/ic_baseline_color_lens_24"
        app:key="theme_header"
        app:title="Appearance" />

    <Preference
        app:fragment="com.kancrutt.gigginggear.SettingsActivity$TracksFragment"
        app:icon="@drawable/ic_baseline_audio_file_24"
        app:key="tracks_settings"
        app:title="Audio Playback" />

    <Preference
        app:fragment="com.kancrutt.gigginggear.SettingsActivity$SyncFragment"
        app:icon="@drawable/ic_baseline_save_alt_24"
        app:key="sync_header"
        app:title="Export Settings" />

    <Preference
        app:fragment="com.kancrutt.gigginggear.SettingsActivity$VersionFragment"
        app:icon="@drawable/ic_baseline_info_24"
        app:key="version_header"
        app:title="Version &amp; License" />

    <Preference
        app:key="disclaimer"
        android:summary="Giggin' Gear — 100% Offline Live Stage Appliance" />
</PreferenceScreen>
