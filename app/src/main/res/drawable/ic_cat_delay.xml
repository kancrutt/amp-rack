<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Clock face: THIN ring (sw1.2 — light, not a camera shutter).
         Diameter echoes the knob language of amp/volume. -->
    <path
        android:pathData="M12,3.5 A8.5,8.5 0 0,1 12,20.5 A8.5,8.5 0 0,1 12,3.5 Z"
        android:strokeColor="#43A047"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent" />

    <!-- Time direction: single 120-degree arc, flowing clockwise.
         Alpha 0.6 thins its presence toward the 0.75px intent
         (ladder keeps sw at 1.2 — effective weight ~0.72). -->
    <path
        android:pathData="M14.5,7.67 A5,5 0 0,1 14.5,16.33"
        android:strokeColor="#43A047"
        android:strokeWidth="1.2"
        android:strokeAlpha="0.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent" />

</vector>
