<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_overlay_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="TONE3000"
            android:textColor="#FF8A00"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Giggin' Gear × TONE3000"
            android:textColor="@color/gg_glass_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <android.widget.ImageButton
            android:id="@+id/t3k_entry_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_baseline_close_24"
            app:tint="@color/gg_glass_text_secondary" />
    </RelativeLayout>

    <!-- Full logo context: use text mark per spec (real logo asset not bundled; use official text mark) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="#1A1A1E"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="TONE3000"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:text="Browse TONE3000"
        android:textColor="#FF8A00"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.06" />

    <TextView
        android:id="@+id/t3k_entry_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textColor="@color/gg_glass_text_primary"
        android:textSize="12.5sp"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/t3k_entry_legal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textSize="10sp"
        android:lineSpacingExtra="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/t3k_browse_btn"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:text="Browse TONE3000"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="@font/plus_jakarta_sans"
        app:cornerRadius="10dp"
        android:backgroundTint="#FF8A00"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/t3k_learn_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:padding="8dp"
        android:text="Learn more at tone3000.com/api"
        android:textColor="#8B8B8F"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textSize="10sp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless" />

</LinearLayout>
