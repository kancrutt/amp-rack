<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="fab_margin">16dp</dimen>
    <!-- Phone fallback: single compact center row (56dp blocks) -->
    <dimen name="signal_chain_height">64dp</dimen>
    <!-- Phone canvas card height, resolved orientation-independently:
         sw<600 phones always read this ladder (base/w360/w400/w480).
         Tablets read layout-sw600dp + historical signal_chain_height.
         A separate name is REQUIRED: signal_chain_height also lives in
         values-w600dp (160dp), which wrongly matches phones in landscape
         (S23 landscape width 825dp >= 600). Telemetry proof: 454px/160dp. -->
    <dimen name="signal_chain_card_height">64dp</dimen>
    <dimen name="param_gear_col_width">115dp</dimen>
    <dimen name="rack_top_bar_height">40dp</dimen>

    <!-- Dynamic Rotary Knob & Label Scaling for Phones -->
    <dimen name="knob_size_large">52dp</dimen>
    <dimen name="knob_size_small">48dp</dimen>
    <dimen name="knob_label_size">8sp</dimen>
    <dimen name="knob_val_size">7.5sp</dimen>
    <dimen name="param_panel_padding">4dp</dimen>

    <!-- ============================================================
         GLASS DESIGN TOKENS — Radii, Spacing, Elevation
         ============================================================ -->
    <!-- Corner radii -->
    <dimen name="gg_glass_radius_card">14dp</dimen>
    <dimen name="gg_glass_radius_panel">12dp</dimen>
    <dimen name="gg_glass_radius_button">10dp</dimen>
    <dimen name="gg_glass_radius_dialog">20dp</dimen>
    <dimen name="gg_glass_radius_chip">20dp</dimen>

    <!-- Border -->
    <dimen name="gg_glass_border_width">1dp</dimen>

    <!-- Elevation / depth (for shadow, not actual elevation to avoid clipping) -->
    <dimen name="gg_glass_elevation_card">4dp</dimen>
    <dimen name="gg_glass_elevation_panel">6dp</dimen>
    <dimen name="gg_glass_elevation_overlay">12dp</dimen>

    <!-- Spacing scale -->
    <dimen name="gg_glass_spacing_xs">4dp</dimen>
    <dimen name="gg_glass_spacing_sm">8dp</dimen>
    <dimen name="gg_glass_spacing_md">16dp</dimen>
    <dimen name="gg_glass_spacing_lg">24dp</dimen>

    <!-- Inner padding -->
    <dimen name="gg_glass_padding_card">12dp</dimen>
    <dimen name="gg_glass_padding_panel">16dp</dimen>

    <!-- Signal block node dimensions -->
    <dimen name="gg_glass_block_min_width">72dp</dimen>
    <dimen name="gg_glass_block_min_height">40dp</dimen>

    <!-- Drum sample list rows (track_file.xml). Base values/ = phone-class:
         taller touch targets + more breathing room, funded by the regrouped
         Loop/Load/Skip row. Tablet overrides in values-sw600dp keep the
         confirmed 48dp rows untouched. -->
    <dimen name="track_row_min_height">60dp</dimen>
    <dimen name="track_row_button_height">56dp</dimen>
    <dimen name="track_row_margin_v">8dp</dimen>
    <dimen name="track_row_delete_width">48dp</dimen>
    <dimen name="track_row_delete_height">56dp</dimen>
</resources>
