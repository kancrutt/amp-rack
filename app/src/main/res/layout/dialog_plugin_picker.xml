<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#15171B"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#3A3A3C" />

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/picker_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="ADD EFFECT BLOCK"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:letterSpacing="0.05" />

        <ImageButton
            android:id="@+id/picker_close_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_baseline_close_24"
            app:tint="#8E8E93" />
    </RelativeLayout>

    <!-- Search Bar -->
    <EditText
        android:id="@+id/picker_search"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:background="#1E1E22"
        android:drawableLeft="@drawable/ic_baseline_close_24"
        android:drawablePadding="8dp"
        android:hint="Search plugins..."
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#6C6C70"
        android:textSize="14sp"
        app:drawableTint="#6C6C70" />

    <!-- Category Tabs Horizontal Scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/picker_category_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_all"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="ALL"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#1E1E22"
                app:chipStrokeColor="#FF9500"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_amps"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AMP/CAB"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#1E1E22"
                app:chipStrokeColor="#3A3A3C"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_overdrive"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OVERDRIVE"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#1E1E22"
                app:chipStrokeColor="#3A3A3C"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_distortion"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISTORTION"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#1E1E22"
                app:chipStrokeColor="#3A3A3C"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_modulation"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODULATION"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#1E1E22"
                app:chipStrokeColor="#3A3A3C"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_delay"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DELAY"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#1E1E22"
                app:chipStrokeColor="#3A3A3C"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_reverb"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REVERB"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#1E1E22"
                app:chipStrokeColor="#3A3A3C"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_utility"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UTILITY"
                android:textColor="#FFFFFF"
                app:chipBackgroundColor="#1E1E22"
                app:chipStrokeColor="#3A3A3C"
                app:chipStrokeWidth="1dp" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Plugins RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/picker_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>
