<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/super_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#15171B">

    <LinearLayout
        android:id="@+id/rack_master"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header: Signal Routing Mode Selector -->
        <LinearLayout
            android:id="@+id/routing_header_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A1C20"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="SIGNAL ROUTING:"
                android:textColor="#8F94A0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_routing_series"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#FFAA00"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="Series ══►"
                android:textColor="#121214"
                android:textSize="10sp"
                android:textStyle="bold"
                app:cornerRadius="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_routing_parallel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="Parallel ⇇"
                android:textColor="#AAAAAA"
                android:textSize="10sp"
                android:textStyle="bold"
                app:cornerRadius="6dp"
                app:strokeColor="#3A3D45" />

            <android.widget.Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/cpu_meter_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CPU --"
                android:textColor="#8F94A0"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Upper Half: Signal Chain Canvas (Horizontal Flowchart) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:background="#1A1C20"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <com.kancrutt.gigginggear.SignalChainCanvasView
                android:id="@+id/signalChainCanvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="4dp"
                android:paddingEnd="72dp" />

            <!-- FAB to open Plugin Picker BottomSheet -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_add_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="18dp"
                android:contentDescription="Add Block"
                android:src="@android:drawable/ic_input_add"
                app:backgroundTint="#FFAA00"
                app:fabSize="mini"
                app:tint="#121214" />
        </FrameLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:background="#2E3138" />

        <!-- Lower Half: Inline Split-Screen Parameter Editor -->
        <LinearLayout
            android:id="@+id/parameter_editor_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#15171B"
            android:orientation="horizontal"
            android:padding="10dp">

            <!-- Left Column: Amp/Cabinet Gear Graphic Render -->
            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="match_parent"
                android:background="#0C0D0F"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/detail_gear_render"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/gg_gear_placeholder" />
            </FrameLayout>

            <!-- Right Column: Model Browser + Tabs + Control Panels -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Header Row inside editor -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/detail_led"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/led_glowing_active" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/detail_plugin_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-black"
                            android:maxLines="1"
                            android:text="Metal Guitar (MIX READY)"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/detail_plugin_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AMP · NEURAL AMP (NAM)"
                            android:textColor="#8F94A0"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detail_badge_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/gg_pill_bg"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="2dp"
                        android:text="A1"
                        android:textColor="#00FF66"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/detail_enabled_btn"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="26dp"
                        android:paddingLeft="8dp"
                        android:paddingTop="0dp"
                        android:paddingRight="8dp"
                        android:paddingBottom="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="ENABLED"
                        android:textColor="#00E676"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:strokeColor="#00E676" />
                </LinearLayout>

                <!-- Model Browser Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginTop="4dp"
                    android:background="#24262B"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="MODEL:"
                        android:textColor="#8F94A0"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/detail_model_browse_btn"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="22dp"
                        android:backgroundTint="#363942"
                        android:paddingLeft="6dp"
                        android:paddingTop="0dp"
                        android:paddingRight="6dp"
                        android:paddingBottom="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Browse"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        app:cornerRadius="4dp" />

                    <TextView
                        android:id="@+id/detail_model_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Clean Twin / Plexi Tone"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- MAIN / ADVANCED Tabs -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="#24262B"
                    android:padding="2dp">

                    <TextView
                        android:id="@+id/tab_main"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#363942"
                        android:paddingStart="10dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="2dp"
                        android:text="MAIN"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tab_advanced"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="2dp"
                        android:text="ADVANCED"
                        android:textColor="#8F94A0"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Dynamic Parameter Controls Container -->
                <LinearLayout
                    android:id="@+id/container_param_panels"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <!-- LEVEL Panel (shown only if plugin has level controls) -->
                    <LinearLayout
                        android:id="@+id/panel_level"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:background="#1E2024"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:text="LEVEL"
                            android:textColor="#8F94A0"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <HorizontalScrollView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fillViewport="true"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/container_level_knobs"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>

                    <!-- TONE / CONTROLS Panel (expands to fit available parameters) -->
                    <LinearLayout
                        android:id="@+id/panel_tone"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#1E2024"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <TextView
                            android:id="@+id/panel_tone_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:text="CONTROLS"
                            android:textColor="#8F94A0"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fillViewport="true"
                            android:scrollbars="none">

                            <!-- Multi-row container: vertical orientation containing row1 and row2 -->
                            <LinearLayout
                                android:id="@+id/container_tone_knobs"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical" />
                        </HorizontalScrollView>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <!-- Hidden Legacy Views Container (Guarantees backend Java code compiles while views stay 100% hidden) -->
    <LinearLayout
        android:id="@+id/hidden_legacy_views"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:orientation="vertical">

        <TextView android:id="@+id/app_main_title" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ImageView android:id="@+id/logo_img" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ImageView android:id="@+id/midi_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ImageView android:id="@+id/bt_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/midi_name" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/onoff" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ToggleButton android:id="@+id/onofftoggle" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ToggleButton android:id="@+id/record_button" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ToggleButton android:id="@+id/record_trigger" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ToggleButton android:id="@+id/video_button" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ToggleButton android:id="@+id/toggle_video" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ToggleButton android:id="@+id/flip_camera" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextureView android:id="@+id/video_texture" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/video_preview" android:layout_width="wrap_content" android:layout_height="wrap_content" />

        <LinearLayout android:id="@+id/mixer" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:id="@+id/patch_label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/patch_name" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/patch_no" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/patch_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Switch android:id="@+id/tuner_switch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/mixer_label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/pro_label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/sample_rate_display" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ImageView android:id="@+id/lowLatencyWarning" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout android:id="@+id/sr_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout android:id="@+id/patch_master" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout android:id="@+id/mixer_input" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout android:id="@+id/mixer_output" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/mixer_input_label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/mixer_output_label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ProgressBar android:id="@+id/mixer_input_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ProgressBar android:id="@+id/mixer_output_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.google.android.material.slider.Slider android:id="@+id/mixer_input_slider" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.google.android.material.slider.Slider android:id="@+id/mixer_output_slider" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ToggleButton android:id="@+id/mixer_toggle" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/hide_panel" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/patch_up" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/patch_down" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ImageView android:id="@+id/midi_bt_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/midi_device" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/midi_port_mappings" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/midi_port_button" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/midi_display" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/rotary_input_display" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/rotary_input_label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/rotary_output_display" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/rotary_output_label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout android:id="@+id/rotary_rack" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.kancrutt.gigginggear.RotarySeekbar android:id="@+id/rotary_input_volume"
            app:showKnob="true" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.kancrutt.gigginggear.RotarySeekbar android:id="@+id/rotary_output_volume"
            app:showKnob="true" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.google.android.material.button.MaterialButton android:id="@+id/menu_button" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/patch_loading" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
