<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gg_glass_bg">

    <!-- Header bar -->
    <TextView
        android:id="@+id/tuner_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="TUNER"
        android:textColor="@color/gg_glass_text_secondary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.3"
        android:fontFamily="@font/plus_jakarta_sans"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/tuner_close"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close tuner"
        android:src="@drawable/ic_baseline_close_24"
        app:tint="@color/gg_glass_text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Big Note and Frequency Container -->
    <LinearLayout
        android:id="@+id/tuner_note_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tuner_title"
        app:layout_constraintBottom_toTopOf="@id/tuner_meter_box"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tuner_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="E2"
            android:textColor="@color/gg_glass_text_primary"
            android:textSize="84sp"
            android:includeFontPadding="false"
            android:textStyle="bold"
            android:fontFamily="@font/plus_jakarta_sans" />

        <TextView
            android:id="@+id/tuner_freq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="82.41 Hz"
            android:textColor="@color/gg_glass_text_secondary"
            android:textSize="15sp"
            android:fontFamily="@font/plus_jakarta_sans" />
    </LinearLayout>

    <!-- Meter bar -->
    <LinearLayout
        android:id="@+id/tuner_meter_box"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/tuner_labels"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/tuner_marker_flat"
            android:layout_width="20dp"
            android:layout_height="4dp"
            android:background="@color/gg_danger"
            android:alpha="0.5" />

        <View
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1"
            android:background="@drawable/tuner_cents_bar" />

        <View
            android:id="@+id/tuner_marker_sharp"
            android:layout_width="20dp"
            android:layout_height="4dp"
            android:background="@color/gg_danger"
            android:alpha="0.5" />

        <View
            android:id="@+id/tuner_indicator"
            android:layout_width="4dp"
            android:layout_height="24dp"
            android:background="@color/gg_accent" />
    </LinearLayout>

    <!-- Flat / Sharp labels -->
    <LinearLayout
        android:id="@+id/tuner_labels"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/tuner_cents"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◀ FLAT"
            android:textColor="@color/gg_danger"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="@font/plus_jakarta_sans" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/gg_glass_divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SHARP ▶"
            android:textColor="@color/gg_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="@font/plus_jakarta_sans" />
    </LinearLayout>

    <TextView
        android:id="@+id/tuner_cents"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="+0 cents"
        android:textColor="@color/gg_node_status_active"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="@font/plus_jakarta_sans"
        app:layout_constraintBottom_toTopOf="@id/tuner_mute"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tuner_mute"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginBottom="16dp"
        android:minHeight="40dp"
        android:text="MUTE AUDIO: OFF"
        android:textColor="@color/gg_glass_text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="@font/plus_jakarta_sans"
        app:cornerRadius="20dp"
        app:strokeColor="@color/gg_accent"
        app:strokeWidth="1.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
