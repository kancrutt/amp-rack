    <style name="Theme.MySplash" parent="Theme.AppCompat.NoActionBar">
        <!-- Global Google Plus Jakarta Sans typography -->
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <!-- Primary brand color. -->
        <item name="colorPrimary">#256c9a</item>
        <item name="colorPrimaryVariant">@color/teal</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/orange_red</item>
        <item name="colorSecondaryVariant">@color/dark_orange</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/black</item>
        <!-- Dark splash background: works on all API levels -->
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="windowSplashScreenBackground">@drawable/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AmpRack</item>
    </style>

    <style name="Theme.MySplash.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.MySplash.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.MySplash.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

</resources>