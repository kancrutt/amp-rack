<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MySplash" parent="Theme.SplashScreen">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#256c9a</item>
        <item name="colorPrimaryVariant">@color/teal</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/gg_glass_text_primary</item>
        <item name="colorSecondaryVariant">@color/gg_glass_text_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimary</item>
        <!-- Dark splash background on API 31+ (independently set per spec 4.7) -->
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="windowSplashScreenBackground">#121214</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.AmpRack</item>
    </style>
</resources>