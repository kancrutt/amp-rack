<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/super_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gg_glass_bg">

    <LinearLayout
        android:id="@+id/rack_master"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ================= TOP HEADER BAR (capsule/pill, floating) =================
             Mockup order (left->right): Volume | Divider | Save | Preset nav |
             Scene dropdown | Divider | Tempo | CPU. Every id below has live
             backend wiring in Rack.java — zero dummy UI. -->
        <LinearLayout
            android:id="@+id/routing_header_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/rack_top_bar_height"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/glass_topbar_bg"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- [1] Master Volume: speaker icon + slider + % text -->
            <ImageView
                android:id="@+id/top_volume_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Master volume"
                android:src="@drawable/ic_baseline_volume_up_24"
                android:tint="@color/gg_glass_text_secondary" />

            <LinearLayout
                android:id="@+id/top_volume_knob_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="6dp"
                android:paddingEnd="2dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/top_volume_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="80%"
                android:textColor="@color/gg_glass_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- [2] Vertical Divider 1 -->
            <View
                android:id="@+id/top_divider_1"
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="#333333" />

            <!-- [3] Save button: bordered square floppy -->
            <ImageView
                android:id="@+id/top_quick_save"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:padding="4dp"
                android:background="@drawable/glass_save_bg"
                android:contentDescription="Save preset"
                android:src="@drawable/ic_baseline_save_24"
                android:tint="@color/gg_glass_text_secondary" />

            <!-- [4] Preset Controller: < name > — name capped at 20 chars so the
                 arrows hug the name proportionally, never pushed far right. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/preset_prev"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Previous preset"
                    android:src="@drawable/ic_baseline_arrow_back_ios_new_24"
                    android:tint="@color/gg_glass_text_primary" />

                <TextView
                    android:id="@+id/top_preset_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:ellipsize="end"
                    android:ems="12"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:maxEms="20"
                    android:maxLines="1"
                    android:text="1. CLEAN"
                    android:textColor="@color/gg_glass_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/preset_next"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Next preset"
                    android:src="@drawable/ic_baseline_arrow_forward_ios_24"
                    android:tint="@color/gg_glass_text_primary" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- [5] Scene selector pill dropdown ("Scene 1 v") -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/top_scene_dropdown"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:minWidth="0dp"
                android:minHeight="22dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="10dp"
                android:paddingTop="0dp"
                android:paddingEnd="4dp"
                android:paddingBottom="0dp"
                android:layout_marginStart="4dp"
                android:text="Scene 1"
                android:textColor="@color/gg_glass_text_primary"
                android:textSize="10.5sp"
                android:textStyle="bold"
                app:icon="@drawable/baseline_arrow_drop_down_24"
                app:iconGravity="textEnd"
                app:iconSize="14dp"
                app:iconTint="@color/gg_glass_text_primary"
                app:cornerRadius="11dp"
                app:strokeColor="@color/gg_glass_text_secondary"
                app:strokeWidth="1dp" />

            <!-- [6] Vertical Divider 2 -->
            <View
                android:id="@+id/top_divider_2"
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="#333333" />

            <!-- [7] Tempo Display -->
            <TextView
                android:id="@+id/top_bpm_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="120 BPM"
                android:textColor="@color/gg_glass_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- [8] CPU Display -->
            <TextView
                android:id="@+id/cpu_meter_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="CPU 5%"
                android:textColor="@color/gg_glass_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Upper Half: Signal Chain Canvas — floating rounded glassy card,
             same model as the header (glass_topbar_bg: 14dp + 1dp stroke) -->
        <FrameLayout
            android:id="@+id/signal_chain_card"
            android:layout_width="match_parent"
            android:layout_height="@dimen/signal_chain_height"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/glass_topbar_bg"
            android:elevation="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <com.kancrutt.gigginggear.SignalChainCanvasView
                android:id="@+id/signalChainCanvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="4dp"
                android:paddingEnd="52dp" />

            <!-- Square rounded "+" button at far right -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/fab_add_block"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="10dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:contentDescription="Add Block"
                android:text="+"
                android:textColor="@color/gg_accent"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:strokeColor="@color/gg_accent"
                app:strokeWidth="1.5dp" />
        </FrameLayout>

        <!-- Lower Half: Glass Parameter Editor — floating rounded glassy card,
             same model as the header (glass_topbar_bg: 14dp + 1dp stroke).
             (The old full-bleed hairline divider is gone: the card gap replaces it.) -->
        <LinearLayout
            android:id="@+id/parameter_editor_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/glass_topbar_bg"
            android:elevation="6dp"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <!-- LEFT COLUMN: full plugin identity (title, subtype, badge, POWER) + MODEL row + gear render + info strip -->
            <!-- Wrapped in NestedScrollView so the entire panel scrolls on short screens -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="@dimen/param_gear_col_width"
                android:layout_height="match_parent"
                android:background="@drawable/glass_panel_bg"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="4dp"
                android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Title row: name left, POWER switch right -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/detail_led"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/led_glowing_active" />

                    <TextView
                        android:id="@+id/detail_plugin_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:maxLines="1"
                        android:text="Neural Amp Modeler"
                        android:textColor="@color/gg_glass_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/detail_enabled_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:checked="true"
                        android:scaleX="0.75"
                        android:scaleY="0.75"
                        app:switchMinWidth="36dp"
                        app:thumbTint="@color/gg_node_status_active"
                        app:trackTint="@color/gg_glass_surface_card" />

                    <TextView
                        android:id="@+id/detail_enabled_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="1dp"
                        android:text="ON"
                        android:textColor="@color/gg_node_status_active"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <!-- Legacy button kept hidden for code compatibility -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/detail_enabled_btn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone"
                        android:text="ENABLED" />
                </LinearLayout>

                <TextView
                    android:id="@+id/detail_plugin_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="AMP · NEURAL AMP (NAM)"
                    android:textColor="@color/gg_glass_text_secondary"
                    android:textSize="9sp"
                    android:fontFamily="@font/plus_jakarta_sans" />

                <!-- MODEL Browser Row -->
<androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/glass_card_bg"
                android:paddingStart="8dp"
                android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/detail_model_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="MODEL"
                        android:textColor="@color/gg_glass_text_secondary"
                        android:textSize="9sp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/detail_model_browse_btn"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:minHeight="20dp"
                        android:backgroundTint="@color/gg_glass_surface_selected"
                        android:paddingLeft="8dp"
                        android:paddingTop="0dp"
                        android:paddingRight="8dp"
                        android:paddingBottom="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Browse"
                        android:textColor="@color/gg_glass_text_primary"
                        android:textSize="8.5sp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        app:cornerRadius="4dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Gear Graphic & Description Stack -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <ImageView
                        android:id="@+id/detail_gear_render"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/gg_gear_placeholder" />
                </FrameLayout>

                <TextView
                    android:id="@+id/detail_gear_info_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Neural Amp Modeler"
                    android:textColor="@color/gg_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plus_jakarta_sans" />

                <TextView
                    android:id="@+id/detail_gear_info_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="1dp"
                    android:text="Deep learning plugin to create models of guitar amplifiers and pedals with state-of-the-art accuracy."
                    android:textColor="@color/gg_glass_text_secondary"
                    android:textSize="9.5sp"
                    android:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Right Column: Model Browser + Tabs + Control Panels -->
            <LinearLayout
                android:id="@+id/parameter_right_column"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Dynamic Parameter Controls Container -->
                <LinearLayout
                    android:id="@+id/container_param_panels"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="2dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <!-- LEVEL Panel (shown only if plugin has level controls) -->
                    <LinearLayout
                        android:id="@+id/panel_level"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/glass_panel_bg"
                        android:orientation="vertical"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:text="LEVEL"
                            android:textColor="@color/gg_glass_text_secondary"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/plus_jakarta_sans" />

                        <HorizontalScrollView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fillViewport="true"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/container_level_knobs"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>

                    <!-- TONE / CONTROLS Panel (expands to fit available parameters) -->
                    <LinearLayout
                        android:id="@+id/panel_tone"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/glass_panel_bg"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/panel_tone_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:text="CONTROLS"
                            android:textColor="@color/gg_glass_text_secondary"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/plus_jakarta_sans" />

                        <androidx.core.widget.NestedScrollView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fillViewport="true"
                            android:scrollbars="vertical">

                            <!-- Vertical list of slider rows for controls -->
                            <LinearLayout
                                android:id="@+id/container_tone_knobs"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp" />
                        </androidx.core.widget.NestedScrollView>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Hidden Legacy Views Container (Guarantees backend Java code compiles while views stay 100% hidden) -->
    <LinearLayout
        android:id="@+id/hidden_legacy_views"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:orientation="vertical">

        <TextView android:id="@+id/app_main_title" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ImageView android:id="@+id/logo_img" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ImageView android:id="@+id/midi_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ImageView android:id="@+id/bt_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/midi_name" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/onoff" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ToggleButton android:id="@+id/onofftoggle" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ToggleButton android:id="@+id/record_button" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ToggleButton android:id="@+id/record_trigger" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ToggleButton android:id="@+id/video_button" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ToggleButton android:id="@+id/toggle_video" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ToggleButton android:id="@+id/flip_camera" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextureView android:id="@+id/video_texture" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/video_preview" android:layout_width="wrap_content" android:layout_height="wrap_content" />

        <LinearLayout android:id="@+id/mixer" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:id="@+id/patch_label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/patch_name" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/patch_no" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/patch_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Switch android:id="@+id/tuner_switch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/mixer_label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/pro_label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/sample_rate_display" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ImageView android:id="@+id/lowLatencyWarning" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout android:id="@+id/sr_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout android:id="@+id/patch_master" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout android:id="@+id/mixer_input" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout android:id="@+id/mixer_output" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/mixer_input_label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/mixer_output_label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ProgressBar android:id="@+id/mixer_input_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ProgressBar android:id="@+id/mixer_output_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.google.android.material.slider.Slider android:id="@+id/mixer_input_slider" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.google.android.material.slider.Slider android:id="@+id/mixer_output_slider" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ToggleButton android:id="@+id/mixer_toggle" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/hide_panel" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/patch_up" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/patch_down" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <ImageView android:id="@+id/midi_bt_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/midi_device" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/midi_port_mappings" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/midi_port_button" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/midi_display" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/rotary_input_display" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/rotary_input_label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/rotary_output_display" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/rotary_output_label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout android:id="@+id/rotary_rack" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.kancrutt.gigginggear.RotarySeekbar android:id="@+id/rotary_input_volume"
            app:showKnob="true" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.kancrutt.gigginggear.RotarySeekbar android:id="@+id/rotary_output_volume"
            app:showKnob="true" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.google.android.material.button.MaterialButton android:id="@+id/menu_button" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/patch_loading" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
