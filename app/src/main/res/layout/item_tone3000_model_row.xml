<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_card_bg"
    android:layout_marginBottom="4dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/t3k_model_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textColor="@color/gg_glass_text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/t3k_model_arch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1A1A1E"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:textColor="#FF8A00"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/t3k_model_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/gg_glass_text_secondary"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/t3k_model_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone"
        android:progressTint="#FF8A00"
        android:progressBackgroundTint="#2E323B" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/t3k_model_download_btn"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:minWidth="104dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="Load"
        android:textSize="10sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:fontFamily="@font/plus_jakarta_sans"
        app:cornerRadius="6dp"
        android:backgroundTint="@color/gg_surface_2"
        android:textColor="@color/gg_glass_text_primary" />

</LinearLayout>
